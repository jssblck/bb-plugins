{
  "manifest_version": 3,
  "name": "bb Browser",
  "version": "0.1.0",
  "description": "Lets bb agents drive this browser, in your own profile and your own logged-in sessions.",
  "key": "",
  "permissions": [
    "tabs",
    "debugger",
    "scripting",
    "nativeMessaging",
    "storage",
    "alarms"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "bb Browser"
  }
}
